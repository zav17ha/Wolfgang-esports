# ── Blog admin login (/admin) ───────────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-unique-password
# Any long random string (32+ characters). Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ── Blog storage on Vercel ──────────────────────────────────────────────────
# Added automatically when you connect a Blob store (Vercel → Storage → Create → Blob).
# Not needed locally: without it, posts are saved to content/posts/ on your computer.
BLOB_READ_WRITE_TOKEN=

# ── Contact form (optional) ─────────────────────────────────────────────────
# Send messages straight to your inbox with Resend (https://resend.com).
# Without these, the form opens the visitor's email app instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@wolfgangesports.com
CONTACT_FROM_EMAIL=Wolfgang Website <website@wolfgangesports.com>

# ── Site address (sitemap and social previews) ──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://wolfgangesports.com
